diff -rupwN inadyn-2.8.1-orig/plugins/alidns.c inadyn-2.8.1/plugins/alidns.c
--- inadyn-2.8.1-orig/plugins/alidns.c	1970-01-01 08:00:00.000000000 +0800
+++ inadyn-2.8.1/plugins/alidns.c	2026-08-21 00:00:00.000000000 +0800
@@ -0,0 +1,756 @@
+/*
+ * AliDNS provider for In-a-Dyn.
+ *
+ * Uses the Aliyun RPC API with V3 ACS3-HMAC-SHA256 signatures. The provider
+ * updates an existing A record and never creates records.
+ */
+
+#include <arpa/inet.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "json.h"
+#include "plugin.h"
+
+#define ALIDNS_SERVER       "alidns.aliyuncs.com"
+#define ALIDNS_API_VERSION  "2015-01-09"
+#define ALIDNS_ALGORITHM    "ACS3-HMAC-SHA256"
+#define ALIDNS_DEFAULT_TTL  600
+#define ALIDNS_QUERY_SIZE   2048
+#define ALIDNS_REQUEST_SIZE (ALIDNS_QUERY_SIZE + 2048)
+#define ALIDNS_EMPTY_SHA256 \
+	"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
+
+typedef struct {
+	char record_id[64];
+	char rr[SERVER_NAME_LEN];
+} alidns_data_t;
+
+typedef struct {
+	const char *key;
+	const char *value;
+} alidns_param_t;
+
+static int setup   (ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alias);
+static int request (ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alias);
+static int response(http_trans_t *trans, ddns_info_t *info, ddns_alias_t *alias);
+
+static ddns_system_t plugin = {
+	.name         = "default@alidns.com",
+
+	.setup        = (setup_fn_t)setup,
+	.request      = (req_fn_t)request,
+	.response     = (rsp_fn_t)response,
+
+	.checkip_name = DYNDNS_MY_IP_SERVER,
+	.checkip_url  = DYNDNS_MY_CHECKIP_URL,
+	.checkip_ssl  = DYNDNS_MY_IP_SSL,
+
+	.server_name  = ALIDNS_SERVER,
+	.server_url   = "/"
+};
+
+typedef struct {
+	uint32_t state[8];
+	uint64_t bitlen;
+	size_t datalen;
+	unsigned char data[64];
+} alidns_sha256_ctx_t;
+
+static uint32_t sha256_rotr(uint32_t value, unsigned int bits)
+{
+	return (value >> bits) | (value << (32 - bits));
+}
+
+static const uint32_t sha256_k[64] = {
+	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+	0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+	0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+	0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+	0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+	0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+	0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+	0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+	0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+};
+
+static void sha256_transform(alidns_sha256_ctx_t *ctx,
+			      const unsigned char block[64])
+{
+	uint32_t w[64];
+	uint32_t a, b, c, d, e, f, g, h;
+	uint32_t s0, s1, ch, maj, t1, t2;
+	unsigned int i;
+
+	for (i = 0; i < 16; i++)
+		w[i] = ((uint32_t)block[i * 4] << 24) |
+		       ((uint32_t)block[i * 4 + 1] << 16) |
+		       ((uint32_t)block[i * 4 + 2] << 8) |
+		       (uint32_t)block[i * 4 + 3];
+	for (i = 16; i < 64; i++) {
+		s0 = sha256_rotr(w[i - 15], 7) ^ sha256_rotr(w[i - 15], 18) ^
+		     (w[i - 15] >> 3);
+		s1 = sha256_rotr(w[i - 2], 17) ^ sha256_rotr(w[i - 2], 19) ^
+		     (w[i - 2] >> 10);
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+
+	a = ctx->state[0];
+	b = ctx->state[1];
+	c = ctx->state[2];
+	d = ctx->state[3];
+	e = ctx->state[4];
+	f = ctx->state[5];
+	g = ctx->state[6];
+	h = ctx->state[7];
+	for (i = 0; i < 64; i++) {
+		s1 = sha256_rotr(e, 6) ^ sha256_rotr(e, 11) ^ sha256_rotr(e, 25);
+		ch = (e & f) ^ ((~e) & g);
+		t1 = h + s1 + ch + sha256_k[i] + w[i];
+		s0 = sha256_rotr(a, 2) ^ sha256_rotr(a, 13) ^ sha256_rotr(a, 22);
+		maj = (a & b) ^ (a & c) ^ (b & c);
+		t2 = s0 + maj;
+		h = g;
+		g = f;
+		f = e;
+		e = d + t1;
+		d = c;
+		c = b;
+		b = a;
+		a = t1 + t2;
+	}
+
+	ctx->state[0] += a;
+	ctx->state[1] += b;
+	ctx->state[2] += c;
+	ctx->state[3] += d;
+	ctx->state[4] += e;
+	ctx->state[5] += f;
+	ctx->state[6] += g;
+	ctx->state[7] += h;
+}
+
+static void sha256_init(alidns_sha256_ctx_t *ctx)
+{
+	ctx->state[0] = 0x6a09e667;
+	ctx->state[1] = 0xbb67ae85;
+	ctx->state[2] = 0x3c6ef372;
+	ctx->state[3] = 0xa54ff53a;
+	ctx->state[4] = 0x510e527f;
+	ctx->state[5] = 0x9b05688c;
+	ctx->state[6] = 0x1f83d9ab;
+	ctx->state[7] = 0x5be0cd19;
+	ctx->bitlen = 0;
+	ctx->datalen = 0;
+}
+
+static void sha256_update(alidns_sha256_ctx_t *ctx,
+			   const unsigned char *data, size_t len)
+{
+	while (len--) {
+		ctx->data[ctx->datalen++] = *data++;
+		if (ctx->datalen == sizeof(ctx->data)) {
+			sha256_transform(ctx, ctx->data);
+			ctx->bitlen += 512;
+			ctx->datalen = 0;
+		}
+	}
+}
+
+static void sha256_final(alidns_sha256_ctx_t *ctx, unsigned char digest[32])
+{
+	uint64_t bitlen = ctx->bitlen + (uint64_t)ctx->datalen * 8;
+	unsigned int i;
+
+	ctx->data[ctx->datalen++] = 0x80;
+	if (ctx->datalen > 56) {
+		while (ctx->datalen < 64)
+			ctx->data[ctx->datalen++] = 0;
+		sha256_transform(ctx, ctx->data);
+		ctx->datalen = 0;
+	}
+	while (ctx->datalen < 56)
+		ctx->data[ctx->datalen++] = 0;
+	for (i = 0; i < 8; i++)
+		ctx->data[56 + i] = (unsigned char)(bitlen >> (56 - i * 8));
+	sha256_transform(ctx, ctx->data);
+
+	for (i = 0; i < 8; i++) {
+		digest[i * 4] = (unsigned char)(ctx->state[i] >> 24);
+		digest[i * 4 + 1] = (unsigned char)(ctx->state[i] >> 16);
+		digest[i * 4 + 2] = (unsigned char)(ctx->state[i] >> 8);
+		digest[i * 4 + 3] = (unsigned char)ctx->state[i];
+	}
+}
+
+static void hmac_sha256(const char *secret, const char *message,
+			 size_t message_len, unsigned char digest[32])
+{
+	unsigned char key[64];
+	unsigned char key_hash[32];
+	unsigned char ipad[64];
+	unsigned char opad[64];
+	unsigned char inner[32];
+	alidns_sha256_ctx_t hash;
+	const unsigned char *secret_bytes = (const unsigned char *)secret;
+	size_t key_len = strlen(secret);
+	unsigned int i;
+
+	if (key_len > sizeof(key)) {
+		alidns_sha256_ctx_t key_ctx;
+		sha256_init(&key_ctx);
+		sha256_update(&key_ctx, secret_bytes, key_len);
+		sha256_final(&key_ctx, key_hash);
+		memcpy(key, key_hash, sizeof(key_hash));
+		key_len = sizeof(key_hash);
+	} else {
+		memcpy(key, secret_bytes, key_len);
+	}
+	memset(key + key_len, 0, sizeof(key) - key_len);
+	for (i = 0; i < sizeof(key); i++) {
+		ipad[i] = key[i] ^ 0x36;
+		opad[i] = key[i] ^ 0x5c;
+	}
+
+	sha256_init(&hash);
+	sha256_update(&hash, ipad, sizeof(ipad));
+	sha256_update(&hash, (const unsigned char *)message, message_len);
+	sha256_final(&hash, inner);
+
+	sha256_init(&hash);
+	sha256_update(&hash, opad, sizeof(opad));
+	sha256_update(&hash, inner, sizeof(inner));
+	sha256_final(&hash, digest);
+}
+
+static int append_encoded(char *dst, size_t size, size_t *pos, const char *src)
+{
+	const unsigned char *p = (const unsigned char *)src;
+
+	while (*p) {
+		unsigned char c = *p++;
+		if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+		    (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+		    c == '.' || c == '~') {
+			if (*pos + 1 >= size)
+				return -1;
+			dst[(*pos)++] = (char)c;
+		} else {
+			if (*pos + 3 >= size)
+				return -1;
+			snprintf(dst + *pos, size - *pos, "%%%02X", c);
+			*pos += 3;
+		}
+	}
+
+	if (*pos >= size)
+		return -1;
+	dst[*pos] = 0;
+	return 0;
+}
+
+static int append_param(char *dst, size_t size, size_t *pos, int *first,
+			const char *key, const char *value)
+{
+	if (!*first) {
+		if (*pos + 1 >= size)
+			return -1;
+		dst[(*pos)++] = '&';
+		dst[*pos] = 0;
+	}
+	*first = 0;
+
+	if (append_encoded(dst, size, pos, key))
+		return -1;
+	if (*pos + 1 >= size)
+		return -1;
+	dst[(*pos)++] = '=';
+	dst[*pos] = 0;
+	return append_encoded(dst, size, pos, value);
+}
+
+static int append_params(char *dst, size_t size,
+			 const alidns_param_t *params, size_t count)
+{
+	size_t pos = 0;
+	size_t i;
+	int first = 1;
+
+	dst[0] = 0;
+	for (i = 0; i < count; i++) {
+		if (append_param(dst, size, &pos, &first, params[i].key,
+				 params[i].value))
+			return -1;
+	}
+
+	return 0;
+}
+
+static int hex_encode(char *dst, size_t size,
+			      const unsigned char *src, size_t len)
+{
+	static const char digits[] = "0123456789abcdef";
+	size_t i;
+
+	if (len > (size - 1) / 2)
+		return -1;
+	for (i = 0; i < len; i++) {
+		dst[i * 2] = digits[src[i] >> 4];
+		dst[i * 2 + 1] = digits[src[i] & 0x0f];
+	}
+	dst[len * 2] = 0;
+	return 0;
+}
+
+static void make_timestamp(char *timestamp, size_t size)
+{
+	time_t now = time(NULL);
+	struct tm utc;
+
+	memset(&utc, 0, sizeof(utc));
+	gmtime_r(&now, &utc);
+	strftime(timestamp, size, "%Y-%m-%dT%H:%M:%SZ", &utc);
+}
+
+static void make_nonce(char *nonce, size_t size)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	snprintf(nonce, size, "%ld-%ld-%u", (long)tv.tv_sec, (long)tv.tv_usec,
+		 (unsigned)getpid());
+}
+
+static int build_v3_request(char *request, size_t request_size,
+			    const char *action, const char *access_key,
+			    const char *access_secret, const char *query,
+			    const char *timestamp, const char *nonce,
+			    const char *user_agent)
+{
+	static const char signed_headers[] =
+		"host;x-acs-action;x-acs-content-sha256;x-acs-date;"
+		"x-acs-signature-nonce;x-acs-version";
+	char canonical_headers[1024];
+	char canonical_request[ALIDNS_REQUEST_SIZE];
+	char string_to_sign[128];
+	char canonical_hash[65];
+	char signature[65];
+	char authorization[256];
+	unsigned char digest[32];
+	int len;
+
+	len = snprintf(canonical_headers, sizeof(canonical_headers),
+			       "host:%s\n"
+			       "x-acs-action:%s\n"
+			       "x-acs-content-sha256:%s\n"
+			       "x-acs-date:%s\n"
+			       "x-acs-signature-nonce:%s\n"
+			       "x-acs-version:%s\n",
+			       ALIDNS_SERVER, action, ALIDNS_EMPTY_SHA256, timestamp,
+			       nonce, ALIDNS_API_VERSION);
+	if (len < 0 || (size_t)len >= sizeof(canonical_headers))
+		return -1;
+
+	len = snprintf(canonical_request, sizeof(canonical_request),
+			       "POST\n/\n%s\n%s\n%s\n%s",
+			       query, canonical_headers, signed_headers,
+			       ALIDNS_EMPTY_SHA256);
+	if (len < 0 || (size_t)len >= sizeof(canonical_request))
+		return -1;
+
+	{
+		alidns_sha256_ctx_t hash;
+		sha256_init(&hash);
+		sha256_update(&hash, (const unsigned char *)canonical_request,
+				      (size_t)len);
+		sha256_final(&hash, digest);
+	}
+	if (hex_encode(canonical_hash, sizeof(canonical_hash), digest,
+		       sizeof(digest)))
+		return -1;
+
+	len = snprintf(string_to_sign, sizeof(string_to_sign), "%s\n%s",
+		       ALIDNS_ALGORITHM, canonical_hash);
+	if (len < 0 || (size_t)len >= sizeof(string_to_sign))
+		return -1;
+	hmac_sha256(access_secret, string_to_sign, (size_t)len, digest);
+	if (hex_encode(signature, sizeof(signature), digest, sizeof(digest)))
+		return -1;
+
+	len = snprintf(authorization, sizeof(authorization),
+		       "%s Credential=%s,SignedHeaders=%s,Signature=%s",
+		       ALIDNS_ALGORITHM, access_key, signed_headers, signature);
+	if (len < 0 || (size_t)len >= sizeof(authorization))
+		return -1;
+
+	len = snprintf(request, request_size,
+		       "POST /?%s HTTP/1.0\r\n"
+		       "Host: %s\r\n"
+		       "User-Agent: %s\r\n"
+		       "x-acs-action: %s\r\n"
+		       "x-acs-version: %s\r\n"
+		       "x-acs-date: %s\r\n"
+		       "x-acs-signature-nonce: %s\r\n"
+		       "x-acs-content-sha256: %s\r\n"
+		       "Authorization: %s\r\n"
+		       "Accept: application/json\r\n"
+		       "Content-Length: 0\r\n"
+		       "Connection: close\r\n\r\n",
+		       query, ALIDNS_SERVER, user_agent, action, ALIDNS_API_VERSION,
+		       timestamp, nonce, ALIDNS_EMPTY_SHA256, authorization);
+	if (len < 0 || (size_t)len >= request_size)
+		return -1;
+	return len;
+}
+
+static int is_public_ipv4(const char *address)
+{
+	struct in_addr addr;
+	uint32_t ip;
+
+	if (inet_pton(AF_INET, address, &addr) != 1)
+		return 0;
+
+	ip = ntohl(addr.s_addr);
+	if ((ip & 0xff000000U) == 0x00000000U ||
+	    (ip & 0xff000000U) == 0x0a000000U ||
+	    (ip & 0xffc00000U) == 0x64400000U ||
+	    (ip & 0xff000000U) == 0x7f000000U ||
+	    (ip & 0xffff0000U) == 0xa9fe0000U ||
+	    (ip & 0xfff00000U) == 0xac100000U ||
+	    (ip & 0xffff0000U) == 0xc0a80000U ||
+	    (ip & 0xffffff00U) == 0xc0000000U ||
+	    (ip & 0xfffe0000U) == 0xc6120000U ||
+	    ip >= 0xe0000000U)
+		return 0;
+
+	return 1;
+}
+
+static int token_next(const jsmntok_t *tokens, int index)
+{
+	int i;
+	int n;
+
+	if (tokens[index].type == JSMN_OBJECT) {
+		n = tokens[index].size;
+		index++;
+		for (i = 0; i < n; i++) {
+			index = token_next(tokens, index);
+			index = token_next(tokens, index);
+		}
+		return index;
+	}
+
+	if (tokens[index].type == JSMN_ARRAY) {
+		n = tokens[index].size;
+		index++;
+		for (i = 0; i < n; i++)
+			index = token_next(tokens, index);
+		return index;
+	}
+
+	return index + 1;
+}
+
+static int object_value(const char *json, const jsmntok_t *tokens, int object,
+			const char *key)
+{
+	int i = object + 1;
+	int n = tokens[object].size;
+
+	while (n-- > 0) {
+		int value = token_next(tokens, i);
+		if (jsoneq(json, &tokens[i], key) == 0)
+			return value;
+		i = token_next(tokens, value);
+	}
+	return -1;
+}
+
+static int copy_token(char *dst, size_t size, const char *json,
+		      const jsmntok_t *token)
+{
+	size_t len;
+
+	if (token->type != JSMN_STRING)
+		return -1;
+	len = (size_t)(token->end - token->start);
+	if (len + 1 > size)
+		return -1;
+	memcpy(dst, json + token->start, len);
+	dst[len] = 0;
+	return 0;
+}
+
+static int parse_api_error(const char *json, const jsmntok_t *tokens, int count)
+{
+	int value;
+	char code[64];
+
+	if (count <= 0 || tokens[0].type != JSMN_OBJECT)
+		return RC_DDNS_RSP_NOTOK;
+
+	value = object_value(json, tokens, 0, "Code");
+	if (value < 0)
+		return RC_OK;
+	if (copy_token(code, sizeof(code), json, &tokens[value]))
+		return RC_DDNS_RSP_NOTOK;
+
+	logit(LOG_ERR, "AliDNS API error: %s", code);
+	if (strcmp(code, "InvalidAccessKeyId") == 0 ||
+	    strcmp(code, "InvalidAccessKeyId.NotFound") == 0 ||
+	    strcmp(code, "SignatureDoesNotMatch") == 0 ||
+	    strcmp(code, "Forbidden.UserNotFound") == 0 ||
+	    strcmp(code, "Forbidden.RAMUser") == 0 ||
+	    strcmp(code, "NoPermission") == 0)
+		return RC_DDNS_RSP_AUTH_FAIL;
+	return RC_DDNS_RSP_NOTOK;
+}
+
+static int parse_record(const char *json, const jsmntok_t *tokens, int count,
+			alidns_data_t *data)
+{
+	int records;
+	int i;
+	int n;
+	int rc;
+
+	rc = parse_api_error(json, tokens, count);
+	if (rc != RC_OK)
+		return rc;
+
+	if (count <= 0 || tokens[0].type != JSMN_OBJECT)
+		return RC_DDNS_RSP_NOTOK;
+
+	records = object_value(json, tokens, 0, "DomainRecords");
+	if (records < 0 || tokens[records].type != JSMN_OBJECT)
+		return RC_DDNS_RSP_NOHOST;
+	records = object_value(json, tokens, records, "Record");
+	if (records < 0 || tokens[records].type != JSMN_ARRAY)
+		return RC_DDNS_RSP_NOHOST;
+
+	i = records + 1;
+	n = tokens[records].size;
+	while (n-- > 0) {
+		int record = i;
+		int type;
+		int id;
+		int rr;
+		int line;
+
+		if (tokens[record].type != JSMN_OBJECT)
+			return RC_DDNS_RSP_NOTOK;
+		type = object_value(json, tokens, record, "Type");
+		id = object_value(json, tokens, record, "RecordId");
+		rr = object_value(json, tokens, record, "RR");
+		line = object_value(json, tokens, record, "Line");
+		if (type >= 0 && id >= 0 && rr >= 0 && line >= 0 &&
+		    jsoneq(json, &tokens[type], "A") == 0 &&
+		    jsoneq(json, &tokens[line], "default") == 0) {
+			if (copy_token(data->record_id, sizeof(data->record_id),
+				       json, &tokens[id]) ||
+			    copy_token(data->rr, sizeof(data->rr), json, &tokens[rr]))
+				return RC_DDNS_RSP_NOTOK;
+			return 0;
+		}
+		i = token_next(tokens, record);
+	}
+
+	logit(LOG_ERR, "AliDNS A record was not found; refusing to create one.");
+	return RC_DDNS_RSP_NOHOST;
+}
+
+static int query_record(ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alias,
+			alidns_data_t *data)
+{
+	char timestamp[32];
+	char nonce[64];
+	char query[ALIDNS_QUERY_SIZE];
+	char request[ALIDNS_REQUEST_SIZE];
+	alidns_param_t params[5];
+	http_trans_t trans;
+	http_t client;
+	jsmntok_t *tokens = NULL;
+	int token_count;
+	int rc;
+	int len;
+
+	make_timestamp(timestamp, sizeof(timestamp));
+	make_nonce(nonce, sizeof(nonce));
+	params[0] = (alidns_param_t){"Line", "default"};
+	params[1] = (alidns_param_t){"PageNumber", "1"};
+	params[2] = (alidns_param_t){"PageSize", "100"};
+	params[3] = (alidns_param_t){"SubDomain", alias->name};
+	params[4] = (alidns_param_t){"Type", "A"};
+
+	if (append_params(query, sizeof(query), params, 5))
+		return RC_BUFFER_OVERFLOW;
+
+	len = build_v3_request(request, sizeof(request),
+			       "DescribeSubDomainRecords", info->creds.username,
+			       info->creds.password, query, timestamp, nonce,
+			       info->user_agent);
+	if (len < 0)
+		return RC_BUFFER_OVERFLOW;
+	memset(&trans, 0, sizeof(trans));
+
+	trans.req = request;
+	trans.req_len = len;
+	trans.rsp = ctx->work_buf;
+	trans.max_rsp_len = ctx->work_buflen - 1;
+
+	rc = http_construct(&client);
+	if (rc)
+		return -rc;
+	http_set_port(&client, info->ssl_enabled ? HTTPS_DEFAULT_PORT : HTTP_DEFAULT_PORT);
+	http_set_remote_name(&client, info->server_name.name);
+	client.ssl_enabled = info->ssl_enabled;
+	rc = http_init(&client, "AliDNS record query");
+	if (rc) {
+		http_destruct(&client, 1);
+		return -rc;
+	}
+
+	rc = http_transaction(&client, &trans);
+	if (rc) {
+		logit(LOG_WARNING, "AliDNS record query HTTP transaction failed, rc: %d", rc);
+	} else {
+		rc = http_status_valid(trans.status);
+		if (rc)
+			logit(LOG_WARNING, "AliDNS record query HTTP status %d (%s): %.512s",
+			      trans.status, trans.status_desc,
+			      trans.rsp_body ? trans.rsp_body : "");
+	}
+	if (!rc) {
+		token_count = parse_json(trans.rsp_body, &tokens);
+		if (token_count < 0)
+			rc = RC_DDNS_RSP_RETRY_LATER;
+		else
+			rc = parse_record(trans.rsp_body, tokens, token_count, data);
+	}
+	free(tokens);
+	http_exit(&client);
+	http_destruct(&client, 1);
+
+	if (rc)
+		logit(LOG_WARNING, "AliDNS record query failed, rc: %d", rc);
+	return rc;
+}
+
+static int setup(ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alias)
+{
+	alidns_data_t *data;
+	int rc;
+	http_set_port(&info->server, info->ssl_enabled ? HTTPS_DEFAULT_PORT : HTTP_DEFAULT_PORT);
+
+	if (!is_public_ipv4(alias->address)) {
+		logit(LOG_WARNING, "AliDNS refused non-public IPv4 address '%s'.",
+		      alias->address);
+		return RC_DDNS_INVALID_OPTION;
+	}
+
+	data = calloc(1, sizeof(*data));
+	if (!data)
+		return RC_OUT_OF_MEMORY;
+
+	rc = query_record(ctx, info, alias, data);
+	if (rc) {
+		free(data);
+		return rc;
+	}
+
+	if (info->data)
+		free(info->data);
+	info->data = data;
+	return RC_OK;
+}
+
+static int request(ddns_t *ctx, ddns_info_t *info, ddns_alias_t *alias)
+{
+	char timestamp[32];
+	char nonce[64];
+	char ttl[16];
+	char query[ALIDNS_QUERY_SIZE];
+	char request[ALIDNS_REQUEST_SIZE];
+	alidns_data_t *data = (alidns_data_t *)info->data;
+	alidns_param_t params[5];
+	int len;
+
+	if (!data)
+		return RC_INVALID_POINTER;
+
+	make_timestamp(timestamp, sizeof(timestamp));
+	make_nonce(nonce, sizeof(nonce));
+	snprintf(ttl, sizeof(ttl), "%ld",
+		 info->ttl > 0 ? info->ttl : ALIDNS_DEFAULT_TTL);
+	params[0] = (alidns_param_t){"RR", data->rr};
+	params[1] = (alidns_param_t){"RecordId", data->record_id};
+	params[2] = (alidns_param_t){"TTL", ttl};
+	params[3] = (alidns_param_t){"Type", "A"};
+	params[4] = (alidns_param_t){"Value", alias->address};
+
+	if (append_params(query, sizeof(query), params, 5))
+		return RC_BUFFER_OVERFLOW;
+
+	len = build_v3_request(request, sizeof(request), "UpdateDomainRecord",
+			       info->creds.username, info->creds.password, query,
+			       timestamp, nonce, info->user_agent);
+	if (len < 0 || (size_t)len >= sizeof(request))
+		return RC_BUFFER_OVERFLOW;
+	return snprintf(ctx->request_buf, ctx->request_buflen, "%s", request);
+}
+
+static int response(http_trans_t *trans, ddns_info_t *info, ddns_alias_t *alias)
+{
+	jsmntok_t *tokens = NULL;
+	int token_count;
+	int rc;
+
+	(void)info;
+
+	rc = http_status_valid(trans->status);
+	if (rc) {
+		logit(LOG_WARNING, "AliDNS update HTTP status %d (%s): %.512s",
+		      trans->status, trans->status_desc,
+		      trans->rsp_body ? trans->rsp_body : "");
+		return rc;
+	}
+	token_count = parse_json(trans->rsp_body, &tokens);
+	if (token_count < 0)
+		return RC_DDNS_RSP_RETRY_LATER;
+
+	rc = parse_api_error(trans->rsp_body, tokens, token_count);
+	if (rc == RC_OK &&
+	    object_value(trans->rsp_body, tokens, 0, "RecordId") < 0)
+		rc = RC_DDNS_RSP_NOTOK;
+	if (rc == RC_OK)
+		logit(LOG_INFO, "AliDNS record '%s' updated to %s.",
+		      alias->name, alias->address);
+
+	free(tokens);
+	return rc;
+}
+
+PLUGIN_INIT(plugin_init)
+{
+	plugin_register(&plugin);
+}
+
+PLUGIN_EXIT(plugin_exit)
+{
+	plugin_unregister(&plugin);
+}
